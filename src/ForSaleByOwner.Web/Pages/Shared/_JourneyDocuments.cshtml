@model ForSaleByOwner.Web.Pages.App.PrepareModel
@using ForSaleByOwner.BLL
<div class="document-lifecycle"><span>1 Choose</span><span>2 Process</span><span>3 Review</span><span>4 Confirm</span><span>5 Save</span></div>
@if(Model.SelectedDocument is {} doc) {
    <article class="panel document-review"><div class="section-heading"><div><span class="pill">@doc.Status</span><h3>@doc.Filename</h3><small>Version @doc.Version · @string.Join(" + ",doc.Sections)</small></div><a class="text-link" href="@Model.StepPath">← Library</a></div>
    @if(doc.Status=="Processing") {
        <div class="processing-demo"><span class="spark">✳</span><h3>Ready to read this sample.</h3><p>Run the deterministic demo analysis to see the review stage. No real OCR or AI analysis is taking place.</p><form method="post" asp-page-handler="Process"><input type="hidden" name="Revision" value="@Model.Journey.Revision" /><input type="hidden" name="Document" value="@doc.Id" /><button class="button">Run sample analysis →</button></form></div>
    } else if(doc.Status is "Unreadable" or "Wrong property" or "Property changed — replace sample") {
        <div class="notice"><strong>@(doc.Status=="Unreadable"?"We couldn't read this sample.":"This source is not confirmed for your current property.")</strong><p>@(doc.Status=="Unreadable"?"Choose a readable sample below, or enter known facts manually. Retrying identical unreadable content won't invent an answer.":"No extracted facts will be applied. Bundled records belong to 1842 Live Oak Lane in Austin. Restore that fictional address to use them, or enter your own sample facts manually.")</p><a class="text-link" href="@Model.StepPath">Choose another sample →</a> <a class="text-link" href="/app/prepare/details/facts">Enter facts manually →</a></div>
    } else if(doc.Status=="Superseded") { <p class="notice">This version is retained for history. Review the latest version in your library.</p> }
    else {
        <div class="source-review-grid"><section class="source-pages" aria-label="Sample source pages"><p class="eyebrow">SOURCE DOCUMENT · FICTIONAL</p>@for(var i=0;i<Model.SelectedSample!.Pages.Length;i++) { <article class="source-page"><small>PAGE @(i+1)</small><p>@Model.SelectedSample.Pages[i]</p></article> }<a class="text-link" href="@doc.SourcePath" target="_blank" rel="noopener">Open complete sample ↗</a></section>
        <section class="finding-list"><p class="eyebrow">WHAT WE FOUND · PLEASE REVIEW</p>@foreach(var finding in doc.Findings) {
            var existing=Model.Journey.Answers.GetValueOrDefault(finding.Field);var conflict=existing?.Status=="Confirmed"&&existing.Value!=finding.Value;
            <article class="finding-card"><span class="pill">@(conflict?"CONFLICT":finding.Status)</span><h3>@finding.Label</h3><p class="finding-value">@finding.Value</p><small>@doc.Filename · page @finding.Page</small>@if(conflict) { <p class="conflict-note">Your confirmed answer is <strong>@existing!.Value</strong>. Confirming replaces it; editing lets you keep or correct the value.</p> }
            @if(finding.Status=="Not sure") { <p class="fine-print">Follow-up saved. Your existing confirmed value has not changed.</p> }
            <form method="post" asp-page-handler="Finding"><input type="hidden" name="Revision" value="@Model.Journey.Revision" /><input type="hidden" name="Document" value="@doc.Id" /><input type="hidden" name="finding" value="@finding.Id" /><label for="correct-@finding.Id">Correct or keep a value</label><input id="correct-@finding.Id" name="corrected" value="@(conflict?existing!.Value:finding.Value)" maxlength="160" /><div class="finding-actions"><button name="decision" value="confirm" class="button">Confirm @finding.Value</button><button name="decision" value="edit" class="button secondary">Save edited value</button><button name="decision" value="unsure" class="text-link">Not sure</button></div></form></article>
        }</section></div>
    }
    </article>
}
<div class="sample-library"><p class="eyebrow">BUNDLED SAMPLES · NO PERSONAL DOCUMENTS</p>@foreach(var sample in Model.Samples) {
    var existing=Model.Journey.Documents.Where(d=>d.Kind==sample.Kind).OrderByDescending(d=>d.Version).FirstOrDefault();
    <article class="sample-row"><span class="document-icon">▤</span><div><h3>@sample.Title</h3><small>@string.Join(" + ",sample.Sections) @(existing is null?"":$"· v{existing.Version} · {existing.Status}")</small></div><div class="sample-actions">@if(existing is not null) { <a class="text-link" href="@Model.StepPath?document=@existing.Id">Open →</a> }<form method="post" asp-page-handler="AddDocument"><input type="hidden" name="Revision" value="@Model.Journey.Revision" /><input type="hidden" name="kind" value="@sample.Kind" /><input type="hidden" name="replace" value="@(existing is not null ? "true":"false")" /><button class="button secondary">@(existing is null?"Use sample":"Replace · new version")</button></form></div></article>
}</div>
<section class="panel local-preview" x-data="documentPreview"><h3>Want to see how your file would look?</h3><p>Select a PDF, JPG, PNG, or WebP under 10 MB. The file stays in this browser and is neither uploaded, analyzed, nor saved.</p><label for="local-document">Preview a local file</label><input id="local-document" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" x-on:change="choose" /><p x-text="error" role="alert"></p><p x-text="name"></p><img x-show="isImage" x-bind:src="imageUrl" alt="Local document preview" x-cloak /><a x-show="hasFile" x-bind:href="url" target="_blank" rel="noopener" class="text-link" x-cloak>Open local preview ↗</a></section>
