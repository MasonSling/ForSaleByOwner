@model ForSaleByOwner.BLL.SaleWorkspace
<section id="task-list" class="panel task-panel" aria-live="polite"><div class="section-heading"><h3>Your selling plan</h3><span>@Model.Tasks.Count(t=>t.Complete) / @Model.Tasks.Count complete</span></div><progress value="@Model.Tasks.Count(t=>t.Complete)" max="@Model.Tasks.Count" aria-label="Selling plan progress"></progress>@foreach(var t in Model.Tasks) { <form method="post" action="/app?handler=Toggle" hx-post="/app?handler=Toggle" hx-target="#task-list" hx-swap="outerHTML" class="task-row">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><button class="task-check @(t.Complete ? "checked" : "")" aria-label="@(t.Complete ? "Mark incomplete: " : "Mark complete: ")@t.Title" aria-pressed="@t.Complete.ToString().ToLowerInvariant()">@(t.Complete ? "✓" : "○")</button><div><strong>@t.Title</strong><small>@t.Detail</small></div></form> }</section>
