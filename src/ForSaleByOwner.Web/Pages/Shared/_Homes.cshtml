@model IReadOnlyList<ForSaleByOwner.BLL.Listing>
<section id="home-results" class="homes-results" aria-live="polite"><p class="eyebrow">@Model.Count SAMPLE HOMES</p>@if(Model.Count == 0) { <div class="panel"><h3>No homes match those filters.</h3><p>Try a different city or a higher price limit.</p><a href="/homes" class="text-link">Clear filters →</a></div> }<div class="three-grid">@foreach(var h in Model) { <a class="home-card" href="/homes/@h.Id"><img src="@h.Image" alt="Sample exterior for @h.Address" loading="lazy" /><div><span class="pill">SAMPLE · BY OWNER</span><div class="home-price">@h.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</div><h3>@h.Address</h3><p>@h.City, Texas</p><div class="home-facts"><span>@h.Beds beds</span><span>@h.Baths baths</span><span>@h.Area.ToString("N0") sq ft</span></div></div></a> }</div></section>
