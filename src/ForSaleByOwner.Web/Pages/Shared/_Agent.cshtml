@model ForSaleByOwner.Web.Pages.App.WorkspaceModel
<section id="agent-panel" class="panel agent-panel"><div class="guide-heading"><span class="spark">✳</span><div><strong>Your selling guide</strong><small>ONE STEP AHEAD, RIGHT BESIDE YOU</small></div></div><div class="conversation" role="log" aria-live="polite">@foreach(var m in Model.Workspace.Messages) { <div class="chat-bubble @(m.Role == "seller" ? "seller" : "")"><small>@(m.Role == "seller" ? "You" : "Your guide")</small><p>@m.Text</p></div> }</div>@if(Model.Notice is not null) { <p role="status">@Model.Notice</p> }<div class="suggestions">@foreach(var prompt in new[]{"What do I do next?","Explain lead disclosure","Draft my listing"}) { <form method="post" action="/app/@Model.Section?handler=Ask" hx-post="/app/@Model.Section?handler=Ask" hx-target="#agent-panel" hx-swap="outerHTML">@Html.AntiForgeryToken()<button name="prompt" value="@prompt">@prompt ↗</button></form> }</div><form method="post" action="/app/@Model.Section?handler=Ask" hx-post="/app/@Model.Section?handler=Ask" hx-target="#agent-panel" hx-swap="outerHTML" class="chat-form">@Html.AntiForgeryToken()<label class="sr-only" for="prompt">Ask your guide</label><input name="prompt" id="prompt" placeholder="What's on your mind?" maxlength="1000" required /><button type="submit" aria-label="Send message">↑</button></form><p class="fine-print">Simulated AI · Guidance, not legal advice.<br /><a href="/app/listing">View listing draft →</a> · <a href="/app/documents">View documents →</a></p></section>
