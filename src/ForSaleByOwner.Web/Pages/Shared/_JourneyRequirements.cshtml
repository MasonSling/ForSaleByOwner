@model ForSaleByOwner.Web.Pages.App.PrepareModel
@using ForSaleByOwner.BLL
@{ var j=Model.Journey; }
<article class="requirement-card"><span class="pill">DISCLOSURE OBLIGATION · APPLICABILITY REVIEW</span><h3>Seller's Disclosure Notice</h3><p>Gather known condition and repair information. Confirm applicability and any exemption with a qualified professional. Reviewing this guidance is not completing the notice.</p><a class="text-link" href="https://www.trec.texas.gov/forms/sellers-disclosure-notice" target="_blank" rel="noopener">Official TREC source ↗</a><label class="checkbox-label"><input type="checkbox" name="Answers[disclosureReviewed]" value="yes" checked="@JourneyService.Confirmed(j,"disclosureReviewed")" /> I understand the next preparation step</label></article>
@if(JourneyService.NeedsLead(j)) {
<article class="requirement-card"><span class="pill">FEDERAL RULE · PRE-1978 HOUSING</span><h3>Lead-based paint disclosure</h3><p>Federal law requires lead disclosures for most pre-1978 home sales. Before the buyer signs, the applicable process includes the disclosure, EPA pamphlet, available reports, and the inspection opportunity. Review the official exemptions and timing.</p>@if(!JourneyService.Confirmed(j,"year")) { <p class="notice">Confirm your year built in Home details before deciding applicability.</p> }
<a class="text-link" href="https://www.epa.gov/lead/real-estate-disclosures-about-potential-lead-hazards" target="_blank" rel="noopener">EPA requirements and exemptions ↗</a><label for="lead-exemption">After reviewing the source</label><select id="lead-exemption" name="Answers[leadExemption]"><option value="">I haven't checked yet</option><option selected="@(JourneyService.Value(j,"leadExemption")=="No exemption identified")">No exemption identified</option><option selected="@(JourneyService.Value(j,"leadExemption")=="I need an exemption reviewed")">I need an exemption reviewed</option></select><label class="checkbox-label"><input type="checkbox" name="Answers[leadReviewed]" value="yes" checked="@JourneyService.Confirmed(j,"leadReviewed")" /> I understand what to prepare and when</label></article>
}
@if(JourneyService.Value(j,"hoa")!="No"||!JourneyService.Confirmed(j,"hoa")) {
<article class="requirement-card"><span class="pill">ASSOCIATION INFORMATION · PROFESSIONAL REVIEW</span><h3>HOA documents and addendum</h3><p>You recorded HOA status as “@JourneyService.Value(j,"hoa")” in Your property. Gather current association information and review the appropriate addendum with your title or legal professional.</p><a class="text-link" href="https://www.trec.texas.gov/forms/addendum-property-subject-mandatory-membership-property-owners-association" target="_blank" rel="noopener">Official TREC source ↗</a><label class="checkbox-label"><input type="checkbox" name="Answers[hoaReviewed]" value="yes" checked="@JourneyService.Confirmed(j,"hoaReviewed")" /> I understand the association-information task</label></article>
}
<article class="requirement-card"><span class="pill">RECOMMENDED PREPARATION · PROFESSIONAL HANDOFF</span><h3>Survey, title, and contract</h3><p>Locate existing survey and title records, and choose the professionals who will review the contract and closing package. The sample survey is not legal evidence.</p><label class="checkbox-label"><input type="checkbox" name="Answers[titleReviewed]" value="yes" checked="@JourneyService.Confirmed(j,"titleReviewed")" /> I understand the title and legal handoff</label></article>
<p class="fine-print">These acknowledgements track preparation only. Nothing is signed, delivered, filed, or legally certified by this screen.</p>
