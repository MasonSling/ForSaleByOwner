@page "/homes"
@model ForSaleByOwner.Web.Pages.Homes.IndexModel
@{ ViewData["Title"] = "Find your next chapter"; }
<section class="section-wrap homes-header"><p class="eyebrow">HOMES WITH A PERSONAL CONNECTION</p><h1>Your next chapter<br />could start here.</h1><p>Explore homes, directly from the people who know them best.</p><p class="fine-print">All properties and prices below are fictional demonstration listings.</p><form method="get" hx-get="/homes" hx-target="#home-results" hx-swap="outerHTML" class="filter-bar"><div><label asp-for="City">Texas city</label><input asp-for="City" placeholder="Austin, Dallas…" /></div><div><label asp-for="MaxPrice">Maximum price</label><select asp-for="MaxPrice"><option value="">Any price</option><option value="350000">$350,000</option><option value="500000">$500,000</option><option value="600000">$600,000</option></select></div><div><label asp-for="Beds">Bedrooms</label><select asp-for="Beds"><option value="">Any</option><option value="3">3+</option><option value="4">4+</option></select></div><button class="button">Find a home →</button></form></section><div class="section-wrap"><partial name="_Homes" model="Model.Listings" /></div>
