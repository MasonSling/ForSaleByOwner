@page "/homes/{id}"
@model ForSaleByOwner.Web.Pages.Homes.DetailModel
@{ ViewData["Title"] = Model.Home.Address; var h=Model.Home; }
<article class="section-wrap home-detail"><a class="text-link" href="/homes">← Back to homes</a><img src="@h.Image" alt="Sample exterior for @h.Address" /><div class="two-grid"><div><p class="eyebrow">FICTIONAL LISTING · TEXAS</p><h1>@h.Address</h1><p>@h.City, Texas</p><div class="home-facts"><span>@h.Beds bedrooms</span><span>@h.Baths bathrooms</span><span>@h.Area.ToString("N0") sq ft</span></div><h3 class="mt-8">A place to make your own.</h3><p>@h.Description</p></div><aside class="panel"><h2>@h.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</h2><p>This sample home demonstrates the buyer experience. No seller inquiries or viewing requests are sent.</p><a class="button" href="/start">Selling a home like this? ↗</a><a class="text-link" href="/developers">Explore the AI discovery preview →</a></aside></div></article>
