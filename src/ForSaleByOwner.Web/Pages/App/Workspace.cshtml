@page "/app/{section?}"
@model ForSaleByOwner.Web.Pages.App.WorkspaceModel
@{ ViewData["Title"] = Model.Section == "overview" ? "Your seller workspace" : Model.Section; var w = Model.Workspace; }
<div class="demo-banner">INTERACTIVE DEMO <span>Fictional data · Simulated AI · Nothing is sent or signed</span><form method="post" asp-page-handler="Reset"><button type="submit">Reset demo ↺</button></form></div>
<div class="workspace" hx-history="false"><aside class="sidebar"><p class="eyebrow">YOUR SELLING SPACE</p><nav aria-label="Seller workspace">@foreach(var item in new[]{("overview","Overview","◫"),("agent","Your guide","✳"),("documents","Documents","▤"),("listing","My listing","⌂"),("offers","Offers","⇄"),("closing","Closing","⚑")}) { <a class="@(Model.Section == item.Item1 ? "active" : "")" aria-current="@(Model.Section == item.Item1 ? "page" : null)" href="/app/@(item.Item1 == "overview" ? "" : item.Item1)"><span>@item.Item3</span>@item.Item2</a> }</nav><div class="sidebar-property"><img src="/images/home-1.jpg" alt="Sample property exterior" /><strong>@w.Property.Address</strong><small>@w.Property.City, Texas · @w.Property.Year</small><a href="/app/prepare/property/location">Edit property details →</a></div><p class="fine-print">Your progress stays in this browser session until the app restarts.</p></aside>
<section class="workspace-main"><p class="eyebrow">@w.Property.City.ToUpperInvariant(), TEXAS / YOUR SALE</p>@if(Model.Section != "overview") { <h1>@Model.Heading</h1> }@if(Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
@if(Model.Section == "overview") { <partial name="_JourneyOverview" model="w.Journey" />} else if(Model.Section == "offers") {
<p class="subtitle">Price is one part of the picture. Compare timing, financing, and contingencies too.</p><p class="notice">Illustrative offers only. No buyer has made an offer on your property.</p><div class="table-scroll panel"><table><caption>Sample offer comparison</caption><thead><tr><th>Terms</th><th>Sample buyer A</th><th>Sample buyer B</th></tr></thead><tbody><tr><th>Offer price</th><td>$480,000</td><td>$490,000</td></tr><tr><th>Financing</th><td>Conventional loan</td><td>Conventional loan</td></tr><tr><th>Proposed closing</th><td>30 days</td><td>45 days</td></tr><tr><th>Requested credit</th><td>$0</td><td>$8,000</td></tr><tr><th>Contingencies</th><td>Financing, inspection</td><td>Financing, inspection, home sale</td></tr></tbody></table></div><article class="panel"><h3>Questions worth asking</h3><p>How certain is the financing? Does the timing work for you? What conditions must be met? Review the complete written terms with your legal or title professional before deciding.</p></article>
} else {
<p class="subtitle">A view of what's ahead, with the right people involved at each step.</p><div class="notice">Illustrative sequence only. Actual deadlines come from your reviewed contract; no dates have been calculated or scheduled.</div><ol class="timeline">@foreach(var step in new[]{("Prepare","Gather disclosures, property facts, and listing materials."),("Review an offer","Compare the complete terms with a qualified professional."),("Contract & title","Confirm signatures, effective dates, and title-company instructions."),("Inspection & financing","Track agreed milestones and document any reviewed changes."),("Closing day","Confirm the final package, funds instructions, and recording with your closing professional.")}) { <li><span></span><div><h3>@step.Item1</h3><p>@step.Item2</p></div></li> }</ol><article class="panel"><h3>Your handoff checklist</h3><p>Locate your existing survey and title records. Confirm the title professional's contact information independently. Keep your reviewed contract and completed disclosures together.</p></article>
}
</section></div>

